# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
client/.next/
client/out/

# Environment files (NEVER commit credentials!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env.local
server/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded invoice images (temp storage)
server/uploads/
uploads/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel

# Misc
*.tgz
.cache/

# Test files (keep for reference but not needed in production)
# server/test-all-scenarios.js

# Conversion helper (not needed in production)
client/convert-models.js
